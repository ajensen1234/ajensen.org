		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tailwindcss/typography": "^0.5.19",
		"daisyui": "^5.7.28",
		"mdsvex": "^0.12.8",
		"svelte": "^5.57.0",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^8.2.2"
	}
}
