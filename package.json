{
	"name": "ajensen.org",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun scripts/check-content.ts && vite build",
		"check-content": "bun scripts/check-content.ts",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
